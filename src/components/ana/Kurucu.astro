---
// Founder block: who is behind ReCre, with the portrait on the right.
import { Picture } from 'astro:assets';
import portre from '../../assets/portre-resul.png';
---
<section class="kap iz kurucu">
  <div class="metin">
    <p class="ust">ReCre'nin arkasındaki kişi</p>
    <h2 class="dar metal">Tasarımdan<br />yayına<br />tek el</h2>
    <p class="soluk aciklama">ReCre Studio'yu Resul Çetin kurdu. Menünü, siteni ve Instagram'ını aynı elden çıkarıyoruz; seninle konuşan kişi işi yapan kişi.</p>
    <a class="yazi-link" href="/hakkimizda">Hakkımızda <span aria-hidden="true">→</span></a>
  </div>
  <div class="portre">
    <svg class="yay" aria-hidden="true" viewBox="0 0 560 620" preserveAspectRatio="none"><path d="M500 10 C 620 200, 620 430, 470 610" fill="none" stroke="rgba(236,234,230,.35)" stroke-width="1" /></svg>
    <Picture src={portre} formats={['avif', 'webp']} alt="Resul Çetin, ReCre Studio kurucusu" widths={[360, 520, 1040]} sizes="(max-width: 900px) 360px, 520px" class="resim" />
    <svg class="yildiz" aria-hidden="true" width="26" height="26" viewBox="0 0 24 24"><path d="M12 1 C12.8 8 16 11.2 23 12 C16 12.8 12.8 16 12 23 C11.2 16 8 12.8 1 12 C8 11.2 11.2 8 12 1Z" fill="#ECEAE6" /></svg>
    <div class="not">
      <p class="ust">Yeni projelere</p>
      <p class="dar metal acigiz">Açığız</p>
      <a class="ust konus" href="/iletisim">Konuşalım ↗</a>
    </div>
  </div>
</section>

<style>
  .kurucu { padding-top: 120px; align-items: center; }
  .metin { grid-column: 1 / span 6; position: relative; z-index: 1; }
  h2 { margin-top: 2px; font-size: clamp(48px, 6.7vw, 96px); line-height: .92; }
  .aciklama { margin-top: 28px; max-width: 30rem; font-size: 17px; }
  .yazi-link { display: inline-block; margin-top: 24px; }

  .portre { grid-column: 7 / span 6; position: relative; height: 620px; }
  .yay { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .portre :global(.resim) {
    position: absolute; left: 46%; top: 47%; transform: translate(-50%, -50%);
    width: 86%; max-width: 520px; height: auto;
    -webkit-mask-image: radial-gradient(closest-side, #000 86%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 86%, transparent 100%);
  }
  .yildiz { position: absolute; right: 28px; top: 72px; }
  .not { position: absolute; right: 0; bottom: 24px; text-align: right; }
  .acigiz { margin-top: -4px; font-size: 44px; line-height: 1; }
  .konus { display: inline-block; margin-top: 8px; color: var(--metin); text-decoration: none; }

  @media (max-width: 900px) {
    .metin, .portre { grid-column: 1 / -1; }
    .portre { height: 400px; order: -1; }
    .yay { display: none; }
  }
</style>
