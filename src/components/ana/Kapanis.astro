---
// Closing call to action; shared by the home page and the inner pages.
import { CONTACT } from '../../data/site';

interface Props {
  baslik?: string;
  metin?: string;
}
const {
  baslik = 'Birlikte bir şey yapalım',
  metin = "Menün, siten ya da Instagram'ın için bir fikrin varsa konuşalım.",
} = Astro.props;
---
<section class="kap kapanis">
  <div class="panel iz metal-zemin">
    <h2 class="dar metal">{baslik}</h2>
    <div class="orta">
      <p>{metin}</p>
      <a class="btn" href="/iletisim">Teklif al <span class="ok" aria-hidden="true">↗</span></a>
    </div>
    <ul class="kanallar">
      <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
      <li><a href={CONTACT.whatsapp} target="_blank" rel="noopener">WhatsApp {CONTACT.phoneDisplay}</a></li>
      <li><a href={CONTACT.instagram} target="_blank" rel="noopener">{CONTACT.instagramHandle}</a></li>
    </ul>
  </div>
</section>

<style>
  .kapanis { padding-block: 96px 64px; }
  .metal-zemin {
    padding: 56px; align-items: center;
    background: linear-gradient(110deg, #2B2E35 0%, #5C5F66 38%, #24272D 62%, #1C1E23 100%);
  }
  h2 { grid-column: 1 / span 5; margin-top: -.16em; font-size: clamp(48px, 5vw, 72px); line-height: .95; }
  .orta { grid-column: 6 / span 4; }
  .orta p { font-size: 16px; color: #D7D5D0; }
  .orta .btn { margin-top: 24px; }
  .kanallar {
    grid-column: 10 / span 3; list-style: none; margin: 0; padding: 0 0 0 24px;
    display: flex; flex-direction: column; gap: 14px; font-size: 14px;
    border-left: 1px solid rgba(255, 255, 255, .15);
  }
  .kanallar a { text-decoration: none; overflow-wrap: anywhere; }
  .kanallar a:hover { text-decoration: underline; color: var(--metin); }
  @media (max-width: 900px) {
    .metal-zemin { padding: 32px; row-gap: 32px; }
    h2, .orta, .kanallar { grid-column: 1 / -1; }
    .kanallar { border-left: 0; padding-left: 0; }
  }
</style>
