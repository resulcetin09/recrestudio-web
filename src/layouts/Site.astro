---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../data/site';
// Preloaded for LCP. The tiny *-tr subsets are inlined into the CSS by Vite, so they need no preload.
import antonLatin from '../fonts/anton-latin.woff2?url';
import interLatin from '../fonts/inter-latin.woff2?url';

interface Props {
  title: string;
  description: string;
  /** structured data for this page (schema.org), rendered as JSON-LD */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL('/og-image-1200x630.png', SITE_URL).href;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={antonLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#16181C" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="ReCre Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    <div class="sayfa">
      <Header />
      <main id="icerik">
        <slot />
      </main>
      <Footer />
    </div>

    <div class="izgara-katman kap iz" aria-hidden="true">
      {Array.from({ length: 12 }, () => <span />)}
    </div>
    <script>
      if (new URLSearchParams(location.search).has('izgara')) document.documentElement.classList.add('izgara-acik');
    </script>
  </body>
</html>

<style>
  .sayfa {
    min-height: 100vh;
    display: flex; flex-direction: column;
    background: radial-gradient(90% 600px at 50% 0%, var(--zemin-ust) 0%, var(--zemin) 100%) no-repeat;
  }
  main { flex: 1; }
</style>
